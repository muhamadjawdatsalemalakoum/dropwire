{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dropwire",
  "version": "0.3.0",
  "identifier": "app.dropwire.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dropwire",
        "width": 1280,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640,
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false
      },
      {
        "label": "tray",
        "title": "Dropwire",
        "url": "tray.html",
        "width": 360,
        "height": 470,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Free, private, peer-to-peer file transfer.",
    "longDescription": "Dropwire sends any file straight from one device to another \u2014 end-to-end encrypted, resumable, with no account and no server holding your data. Built on iroh.",
    "copyright": "Copyright \u00a9 2026 Dropwire contributors",
    "publisher": "Dropwire",
    "homepage": "https://muhamadjawdatsalemalakoum.github.io/dropwire/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "installer/Info.plist",
      "signingIdentity": "-",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "section": "net",
        "desktopTemplate": "linux/dropwire.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/dropwire.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsi"
      }
    }
  }
}
